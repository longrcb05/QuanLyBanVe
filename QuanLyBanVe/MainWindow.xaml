<Window x:Class="QuanLyBanVe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Bán Vé" Height="520" Width="850">
    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Thông tin đặt vé" Margin="10,10,10,5">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã vé:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_MaVe" Height="25" Margin="5"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Chuyến xe:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cbo_ChuyenXe" Height="25" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên khách:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txt_TenKhach" Height="25" Margin="5"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Số ĐT:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="txt_SDT" Height="25" Margin="5"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ngày đi:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Row="2" Grid.Column="1" x:Name="dp_NgayDi" Height="25" Margin="5"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Trung chuyển:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txt_TrungChuyen" Height="25" Margin="5"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" x:Name="dtg_DanhSachVe" Margin="10,5,10,10" 
                  AutoGenerateColumns="False" CanUserAddRows="False" Background="White"
                  SelectionChanged="dtg_DanhSachVe_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã vé" Binding="{Binding MaVe}" Width="0.8*"/>
                <DataGridTextColumn Header="Tên hành khách" Binding="{Binding TenKhach}" Width="1.5*"/>
                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SDT}" Width="1*"/>
                <DataGridTextColumn Header="Ngày đi" Binding="{Binding NgayDi, StringFormat=dd/MM/yyyy}" Width="1*"/>
                <DataGridTextColumn Header="Yêu cầu trung chuyển" Binding="{Binding YeuCauTrungChuyen}" Width="2*"/>
                <DataGridTextColumn Header="Tuyến đường" Binding="{Binding TuyenDuong}" Width="1.5*"/>
                <DataGridTextColumn Header="Giờ đi" Binding="{Binding GioXuatBen}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0,10,15">
            <Button x:Name="btn_Them" Content="Thêm vé" Width="90" Height="30" Margin="5" Click="btn_Them_Click"/>
            <Button x:Name="btn_Sua" Content="Sửa thông tin" Width="90" Height="30" Margin="5" Click="btn_Sua_Click"/>
            <Button x:Name="btn_Xoa" Content="Hủy vé" Width="90" Height="30" Margin="5" Click="btn_Xoa_Click"/>
            <Button x:Name="btn_LamMoi" Content="Làm mới" Width="90" Height="30" Margin="5" Click="btn_LamMoi_Click"/>
            <Button x:Name="btn_TimKiem" Content="Tìm kiếm" Width="90" Height="30" Margin="5" Click="btn_TimKiem_Click" Background="#FFD5E8D4"/>
        </StackPanel>
    </Grid>
</Window>